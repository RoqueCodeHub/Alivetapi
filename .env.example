APP_NAME=Veterinaria
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Producción (cPanel): APP_ENV=production, APP_DEBUG=false, APP_URL=https://dominio

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

# Producción HTTPS: SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cron cPanel (cada minuto): php artisan schedule:run
# Tareas: reports:rebuild-daily-summary 00:20, reminders:run 07:00, backup:database 02:00
FORCE_HTTPS=false
BACKUP_KEEP=7

# Facturación electrónica (PSE/OSE). fake = simulación local; http = proveedor autorizado
INVOICE_PSE_DRIVER=fake
INVOICE_PSE_URL=
INVOICE_PSE_TOKEN=
INVOICE_IGV=18
INVOICE_TAX_INCLUDED=true
INVOICE_BOLETA_SIN_DOC_MAX=700
INVOICE_ISSUER_RUC=
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4201,http://127.0.0.1:4201
# Vacío = API solo con Bearer (sin CSRF). No listar :4200 aquí.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION=10080

JWT_SECRET=
